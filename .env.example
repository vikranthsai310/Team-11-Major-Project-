# Copy to .env (gitignored) and fill in. Never commit the real file.

# The only value this project accepts. Anything else raises SettingsError (NFR-7).
CARDANO_NETWORK=preprod

# Blockfrost is the fallback chain-data source and the live submit endpoint.
# Koios is primary and needs no key, so this is optional until Phase 7.
BLOCKFROST_PROJECT_ID=

# Signing keys live outside the repository.
BATCHER_KEY_DIR=~/.cardano-batcher
