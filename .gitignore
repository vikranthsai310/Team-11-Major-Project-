# --- Key material and secrets (NFR-6, NFR-7) ---
*.skey
*.vkey
*.mnemonic
*.addr
.env
.env.*
!.env.example

# --- Datasets: contents are gitignored, provenance is committed (X-8) ---
data/raw/
# Live preprod runs: D4 rows and batcher logs. Summaries reach experiments/ instead.
/data/live/
/logs/
data/processed/*
!data/processed/*.sha256
!data/processed/manifest.json
!data/processed/.gitkeep

# --- Model checkpoints ---
*.ckpt
*.pt
*.pth
*.zip
*.txt.model
experiments/*/models/

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
# Anchored to the repository root. Unanchored, `build/` also matches
# src/batcher/build/ — the fee model and both capacity gates — which silently
# kept that package out of the repository entirely until CI could not import it.
/build/
/dist/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Editors and OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Notebooks ---
.ipynb_checkpoints/
